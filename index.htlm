<style>
body{font-family:'Segoe UI',Arial,sans-serif;margin:0;background:#f8fbff;color:#0f172a}
.header{background:#0b2e5c;color:#fff;padding:20px;text-align:center}
.header h1{margin:0;font-size:28px}
.header p{margin:5px 0 0;opacity:.9}
.rule-box{background:#ffcc00;color:#0b2e5c;padding:15px;text-align:center;font-weight:800;font-size:18px;letter-spacing:1px;border-bottom:4px solid #0b2e5c}
.container{max-width:1100px;margin:auto;padding:20px}
.hero{background:#fff;border-radius:16px;padding:25px;box-shadow:0 4px 20px rgba(0,0,0,.08);margin-bottom:25px;text-align:center}
.hero h2{color:#0b2e5c;margin-top:0}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:20px}
.card{background:#fff;border-radius:16px;padding:20px;box-shadow:0 4px 15px rgba(0,0,0,.06);border-left:6px solid #0b2e5c;transition:.3s}
.card:hover{transform:translateY(-5px);box-shadow:0 8px 25px rgba(0,0,0,.12)}
.card h3{margin:0 0 10px;color:#0b2e5c;font-size:18px}
.card p{font-size:14px;line-height:1.6;color:#334155}
.btn{display:inline-block;margin-top:12px;background:#0b2e5c;color:#fff;padding:10px 18px;border-radius:8px;text-decoration:none;font-weight:700;font-size:14px}
.btn:hover{background:#123e7a}
.tag{display:inline-block;background:#e0f2fe;color:#0b2e5c;padding:3px 8px;border-radius:20px;font-size:11px;font-weight:700;margin-bottom:8px}
.footer{background:#0b2e5c;color:#fff;text-align:center;padding:20px;margin-top:30px}
</style>
</head>
